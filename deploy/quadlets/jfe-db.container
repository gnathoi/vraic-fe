[Unit]
Description=JFE PostgreSQL (authoritative run state)

[Container]
ContainerName=jfe-db
Image=docker.io/library/postgres:17
Label=app=jfe
Network=jfe.network
Volume=jfe-pg.volume:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=jfe POSTGRES_DB=jfe
EnvironmentFile=%h/vraic-fe/.env
HealthCmd=pg_isready -U jfe -d jfe
HealthInterval=10s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
