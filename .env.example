# Copy to .env (never commit .env). Generate secrets with: openssl rand -hex 16
POSTGRES_PASSWORD=replace-with-db-password
JFE_DATABASE_URL=postgresql://jfe:replace-with-db-password@jfe-db:5432/jfe
# Access code: opens a session
JFE_EVENT_CODE=replace-with-access-code
# Admin code: priority runs, admission modes and the /admin dashboard
JFE_OPERATOR_CODE=replace-with-admin-code
# 0 for plain http (e.g. http://localhost:8090); set 1 when served over HTTPS
JFE_SECURE_COOKIE=0
JFE_SIM_BACKEND=auto
JFE_GPU_MIN_DRAWS=256
